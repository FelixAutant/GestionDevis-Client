{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Devis {{ quote.number }}{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <p class="eyebrow"><a href="{{ path('app_quote_index') }}">Devis</a> / {{ quote.client.name }}</p>
        <h1>Devis <span class="doc-number">{{ quote.number }}</span> {% include '_status_badge.html.twig' %}</h1>
    </div>
    <div class="actions">
        <a class="btn" href="{{ path('app_quote_pdf', {id: quote.id}) }}" target="_blank" rel="noopener">{{ ui.icon('eye', 16) }} Aperçu PDF</a>
        <a class="btn" href="{{ path('app_quote_pdf', {id: quote.id, download: 1}) }}">{{ ui.icon('download', 16) }} Télécharger</a>
        {% if quote.editable %}
            <a class="btn btn-primary" href="{{ path('app_quote_edit', {id: quote.id}) }}">{{ ui.icon('edit', 16) }} Modifier</a>
        {% endif %}
    </div>
</div>

<section class="card">
    <dl class="details">
        <dt>Client</dt><dd><a href="{{ path('app_client_show', {id: quote.client.id}) }}">{{ quote.client.name }}</a></dd>
        {% if quote.title %}<dt>Objet</dt><dd>{{ quote.title }}</dd>{% endif %}
        <dt>Date</dt><dd>{{ quote.issueDate|date('d/m/Y') }}</dd>
        <dt>Valable jusqu'au</dt><dd>{{ quote.validUntil|date('d/m/Y') }}</dd>
    </dl>
</section>

<section class="card">
    <h2>Lignes</h2>
    <div class="table-wrap">
    <table class="table-stack">
        <thead><tr><th>Désignation</th><th class="num">Qté</th><th class="num">PU HT</th><th class="num">TVA</th><th class="num">Total HT</th></tr></thead>
        <tbody>
        {% for line in quote.lines %}
            <tr>
                <td>{{ line.description }}</td>
                <td data-label="Qté" class="num">{{ line.quantity|quantity }} {{ line.unit }}</td>
                <td data-label="PU HT" class="num">{{ line.unitPrice|money }}</td>
                <td data-label="TVA" class="num">{{ line.vatRate|vat_rate }}</td>
                <td data-label="Total HT" class="num">{{ line.totalExcludingTax|money }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <dl class="totals">
        <dt>Total HT</dt><dd>{{ totals.totalExcludingTax|money }}</dd>
        {% for rate, row in totals.vatBreakdown %}
            <dt>TVA {{ rate|vat_rate }} <small>(base {{ row.base|money }})</small></dt><dd>{{ row.vat|money }}</dd>
        {% endfor %}
        <dt class="grand">Total TTC</dt><dd class="grand"><strong>{{ totals.totalIncludingTax|money }}</strong></dd>
    </dl>
</section>

{% if quote.notes %}
<section class="card">
    <h2>Conditions / remarques</h2>
    <p class="pre">{{ quote.notes }}</p>
</section>
{% endif %}

<section class="card">
    <h2>Suivi</h2>
    <div class="actions">
        {% for target in quote.status.allowedTransitions %}
            <form method="post" action="{{ path('app_quote_status', {id: quote.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('status_quote_' ~ quote.id) }}">
                <input type="hidden" name="status" value="{{ target.value }}">
                <button class="btn {{ target.value == 'accepted' ? 'btn-primary' }}" type="submit">Marquer « {{ target.label }} »</button>
            </form>
        {% else %}
            <span class="muted">Statut final : aucun changement possible.</span>
        {% endfor %}

        {% if quote.editable %}
            <form method="post" action="{{ path('app_quote_delete', {id: quote.id}) }}" onsubmit="return confirm('Supprimer ce devis ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_quote_' ~ quote.id) }}">
                <button class="btn btn-danger" type="submit">Supprimer</button>
            </form>
        {% endif %}
    </div>
</section>
{% endblock %}
