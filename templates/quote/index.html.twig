{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Devis{% endblock %}

{% block body %}
<div class="page-head">
    <h1>Devis</h1>
    <a class="btn btn-primary" href="{{ path('app_quote_new') }}">{{ ui.icon('plus', 16) }} Nouveau devis</a>
</div>

<form class="search" method="get" role="search">
    <span class="search-icon">{{ ui.icon('search', 18) }}</span>
    <input type="search" name="q" value="{{ term }}" placeholder="Rechercher (n°, client, objet)…" aria-label="Rechercher un devis">
    <select name="status" aria-label="Filtrer par statut">
        <option value="">Tous les statuts</option>
        {% for s in statuses %}
            <option value="{{ s.value }}" {{ status == s ? 'selected' }}>{{ s.label }}</option>
        {% endfor %}
    </select>
    <button class="btn" type="submit">Filtrer</button>
</form>

<section class="card">
    {% if quotes is empty %}
        <p class="muted">Aucun devis ne correspond.</p>
    {% else %}
        <div class="table-wrap">
        <table class="table-stack">
            <thead><tr><th>N°</th><th>Client</th><th>Objet</th><th>Date</th><th>Statut</th><th class="num">Total TTC</th></tr></thead>
            <tbody>
            {% for quote in quotes %}
                <tr>
                    <td><a href="{{ path('app_quote_show', {id: quote.id}) }}">{{ quote.number }}</a></td>
                    <td data-label="Client">{{ quote.client.name }}</td>
                    <td data-label="Objet">{{ quote.title }}</td>
                    <td data-label="Date">{{ quote.issueDate|date('d/m/Y') }}</td>
                    <td data-label="Statut">{% include '_status_badge.html.twig' %}</td>
                    <td data-label="Total TTC" class="num">{{ quote.totals.totalIncludingTax|money }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</section>
{% endblock %}
