{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="page-head"><h1>{{ title }}</h1></div>

<section class="card">
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        <div class="grid-2">
            {{ form_row(form.email) }}
            {{ form_row(form.phone) }}
        </div>
        {{ form_row(form.address) }}
        <div class="grid-2">
            {{ form_row(form.postalCode) }}
            {{ form_row(form.city) }}
        </div>
        {{ form_row(form.notes) }}
        <div class="actions">
            <button class="btn btn-primary" type="submit">Enregistrer</button>
            <a class="btn" href="{{ client.id ? path('app_client_show', {id: client.id}) : path('app_client_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
