{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="auth-card card">
    <h1>🧾 GestionDevis</h1>
    <p class="muted">Devis et clients pour artisans.</p>

    {% if error %}
        <div class="flash flash-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <label for="username">E-mail</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label class="inline"><input type="checkbox" name="_remember_me"> Rester connecté</label>

        <button class="btn btn-primary btn-block" type="submit">Se connecter</button>
    </form>

    {% if demo_mode %}
        <form method="post" action="{{ path('app_demo_login') }}" class="demo-login">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('demo_login') }}">
            <button class="btn btn-block" type="submit">Essayer la démo sans compte</button>
            <p class="muted">Données fictives, remises à zéro régulièrement.</p>
        </form>
    {% endif %}
</div>
{% endblock %}
